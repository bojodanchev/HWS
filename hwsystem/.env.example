# Canonical site URL used by metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
HWS_ADMIN_PASSWORD=
HWS_VOICE_WEBHOOK_SECRET=
# Restricted ElevenLabs lead-capture tool; minimum 32 characters, server-only.
# Required for admin access; use a unique secret of at least 16 characters.
# Production: https://hwsystem.co.uk (configured in Vercel)

# Durable operational storage. Required together in production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Supported aliases for another libSQL-compatible deployment.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional AI phrasing layer. The assistant remains functional without these.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna

# Optional lead delivery integrations.
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
LEAD_INBOX_EMAIL=

# Optional future commerce adapter. Not used by the standalone catalogue or
# customer assistant.
WOO_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
