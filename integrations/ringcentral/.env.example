# Copy to .env locally. Never commit or paste the values into chat.
RINGCENTRAL_SERVER=https://platform.ringcentral.com

# Create an app in https://developer.ringcentral.com/
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=

# Choose exactly one runtime credential source:
# - RINGCENTRAL_ACCESS_TOKEN for a short-lived smoke test
# - RINGCENTRAL_USER_JWT for a single-account local/server integration
# - RINGCENTRAL_REFRESH_TOKEN for an OAuth connection
RINGCENTRAL_ACCESS_TOKEN=
RINGCENTRAL_USER_JWT=
RINGCENTRAL_REFRESH_TOKEN=

# Used only by auth-url (must exactly match the app redirect URI).
RINGCENTRAL_REDIRECT_URI=http://127.0.0.1:8787/oauth/callback
RINGCENTRAL_OAUTH_SCOPE=ReadAccounts ReadMessages ReadCallLog TeamMessaging

# Keep false until the target chat and write operation are reviewed.
RINGCENTRAL_WRITE_ENABLED=false
